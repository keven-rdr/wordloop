    "i18next-resources-to-backend": "1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@hey-api/openapi-ts": "0.99.0",
