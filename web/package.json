    "@typescript-eslint/parser": "8.71.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
