# NAO crie este arquivo a mao: o CI monta o secrets.env na VM a partir dos secrets do GitHub Environment `prd`
# (Settings > Environments > prd). Formato do valor: connection string do banco de producao.
DATABASE_URL=postgres://USUARIO:SENHA@HOST/BANCO?sslmode=require
# Login (opcional, cada grupo e tudo ou nada; com qualquer provedor o SESSION_KEY e obrigatorio):
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...            (secret GH_OAUTH_CLIENT_ID: o GitHub nao deixa secret comecar com GITHUB_)
# GITHUB_CLIENT_SECRET=...
# OIDC_ISSUER=https://seu-idp.exemplo
# OIDC_CLIENT_ID=wordloop
# OIDC_CLIENT_SECRET=...
# SESSION_KEY=<32 bytes em base64: openssl rand -base64 32>
# E-mail (opcional): sem a chave, cadastro e recuperacao por e-mail respondem 503.
# BREVO_API_KEY=...
