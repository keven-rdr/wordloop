# Copie para backup.env na VM (/srv/wordloop/prd), modo 600. NAO entra no Git nem no pacote do CI: so existe na VM.
# Chave PUBLICA do age (age-keygen gera o par; a PRIVADA fica com o dono, FORA da VM). Sem a privada nao ha restauracao.
BACKUP_AGE_RECIPIENT=age1...
# Destino no Cloudflare R2 (bucket privado, com chave restrita a ele).
BACKUP_REMOTE=r2:wordloop-backups/prd
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=...
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=...
RCLONE_CONFIG_R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
# Opcional: healthchecks.io avisa se o backup NAO rodar (o silencio tambem e falha).
# BACKUP_PING_URL=https://hc-ping.com/<uuid>
# Retencao (padrao: 14 dias de todos + 8 semanas do primeiro de cada semana).
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
