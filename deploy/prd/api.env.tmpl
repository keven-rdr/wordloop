# Variaveis NAO secretas da API em producao. NAO e usado como esta: o CI troca {{DOMAIN}} e {{MAIL_FROM}}
# (variaveis do GitHub Environment `prd`: PRD_DOMAIN e, opcional, MAIL_FROM) e grava o api.env na VM.
# O secrets.env (DATABASE_URL, login, e-mail) e montado pelo CI a partir dos secrets do GitHub.
GOMEMLIMIT=100MiB
# Login social: URL publica do callback, a MESMA para Google, GitHub e OIDC (registre-a em cada cliente OAuth). Cookies Secure porque e https.
OIDC_REDIRECT_URL=https://{{DOMAIN}}/api/v1/auth/callback
# Endereco publico do app: o comando create-admin monta o link do convite com ele.
APP_PUBLIC_URL=https://{{DOMAIN}}
# Passkeys (WebAuthn): dominio do site e origem exata. Sem estas duas, o login por passkey fica desligado (503).
WEBAUTHN_RP_ID={{DOMAIN}}
WEBAUTHN_ORIGIN=https://{{DOMAIN}}
# A documentacao interativa (Swagger) nao existe em producao: desligada aqui e bloqueada no Caddy.
API_DOCS_ENABLED=false
# A API so e alcancada pelo Caddy, que poe o IP real em X-Forwarded-For: o limite de tentativas pode confiar nele.
API_TRUST_PROXY=true
# E-mail (cadastro e recuperacao de senha): remetente verificado no provedor. Sem o secret BREVO_API_KEY, esses dois pedidos respondem 503.
MAIL_FROM={{MAIL_FROM}}
MAIL_FROM_NAME=wordloop
