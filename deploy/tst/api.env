# Variaveis NAO secretas da API em tst. O secrets.env (DATABASE_URL) e montado pelo CI a partir do secret do GitHub.
GOMEMLIMIT=100MiB
# Login: URL publica do callback (registre-a no cliente do IdP). Cookies Secure porque e https.
OIDC_REDIRECT_URL=https://tst.wordloop.com.br/api/v1/auth/callback
# Endereco publico do app: o comando create-admin monta o link do convite com ele.
APP_PUBLIC_URL=https://tst.wordloop.com.br
# Passkeys (WebAuthn): dominio do site e origem exata. Sem estas duas, o login por passkey fica desligado (503).
WEBAUTHN_RP_ID=tst.wordloop.com.br
WEBAUTHN_ORIGIN=https://tst.wordloop.com.br
# A API so e alcancada pelo Caddy, que poe o IP real em X-Forwarded-For: o limite de tentativas pode confiar nele.
API_TRUST_PROXY=true
