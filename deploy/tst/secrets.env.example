# Copie para secrets.env na VM (modo 600). NUNCA versione o secrets.env real.
# Limite do GC do Go: ~80% do mem_limit da API (128m).
GOMEMLIMIT=100MiB
# Ainda nao lida pela API; entra com o primeiro modulo que usa banco. Connection string do Neon (sslmode=require).
DATABASE_URL=postgres://USUARIO:SENHA@HOST.neon.tech/wordloop?sslmode=require
