API_ADDR=:8080
APP_ENV=dev
API_DOCS_ENABLED=true

DATABASE_URL=postgres://wordloop:wordloop-dev@localhost:5432/wordloop?sslmode=disable
# Login (BFF). Sem OIDC_ISSUER o login fica desligado (503) e a API sobe normalmente.
# SESSION_KEY: 32 bytes em base64 (ex.: openssl rand -base64 32); cifra o cookie de estado e o refresh token.
SESSION_KEY=
OIDC_ISSUER=http://localhost:8180/realms/wordloop-dev
OIDC_CLIENT_ID=wordloop-api
OIDC_CLIENT_SECRET=wordloop-api-dev-secret
OIDC_REDIRECT_URL=http://localhost:5173/api/v1/auth/callback
